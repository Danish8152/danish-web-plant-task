# AWS RDS MySQL
DB_HOST=your-instance.xxxxxxxx.region.rds.amazonaws.com
DB_PORT=3306
DB_NAME=project_manager
DB_USER=admin
DB_PASSWORD=change-me

# TLS to RDS. Set DB_SSL=false only if your instance doesn't use it.
# DB_SSL_CA_PATH is optional - point it at the RDS CA bundle to verify the certificate.
DB_SSL=true
DB_SSL_CA_PATH=

# any long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=7
